# Ambiente dos testes e2e. Versionado de propósito: nada aqui é segredo real e
# o banco é o container descartável `db-test` do docker-compose (porta 5433).
NODE_ENV=test
PORT=3001
API_PREFIX=api
CORS_ORIGINS=*
LOG_LEVEL=silent

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_test?schema=public

JWT_ACCESS_SECRET=segredo-de-access-apenas-para-os-testes-000000
JWT_REFRESH_SECRET=segredo-de-refresh-apenas-para-os-testes-00000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Limite alto para que o rate limit não derrube as suítes.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100000
THROTTLE_CREDENTIALS_TTL=60000
THROTTLE_CREDENTIALS_LIMIT=100000

SWAGGER_ENABLED=false
SWAGGER_PATH=docs
