// Schema do Prisma. Documentação: https://pris.ly/d/prisma-schema
//
// Depois de alterar este arquivo rode:
//   npm run prisma:migrate -- --name <descricao-da-mudanca>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Papéis usados pelo RolesGuard. Adicione novos papéis aqui e eles ficam
/// disponíveis no decorator @Roles() sem nenhuma outra mudança.
enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Nome completo: apenas letras e espaços, até 30 caracteres.
  name         String   @db.VarChar(30)
  /// Email de login, sempre minúsculo. Até 40 caracteres.
  email        String   @unique @db.VarChar(40)
  /// Matrícula: 4 a 10 dígitos. Texto para preservar zeros à esquerda.
  registration String   @unique @db.VarChar(10)
  /// Hash argon2id. Nunca sai da camada de repositorio.
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// Momento da última edição; nulo enquanto o cadastro nunca foi editado.
  updatedAt    DateTime?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  /// Acelera a busca por nome da listagem, que ordena por nome.
  @@index([name])
  @@map("users")
}

/// Uma linha por refresh token emitido. O token em si nunca e persistido,
/// apenas o hash, e o `id` da linha viaja como `jti` dentro do JWT.
/// Isso permite rotacionar e revogar sessões individualmente.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Token de uso único para redefinir a senha. Como no refresh token, apenas o
/// hash é persistido; o valor em claro só existe no link enviado por e-mail.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
