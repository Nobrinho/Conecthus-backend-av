// Schema do Prisma. Documentação: https://pris.ly/d/prisma-schema
//
// Depois de alterar este arquivo rode:
//   npm run prisma:migrate -- --name <descricao-da-mudanca>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Papéis usados pelo RolesGuard. Adicione novos papéis aqui e eles ficam
/// disponíveis no decorator @Roles() sem nenhuma outra mudança.
enum Role {
  USER
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  /// Hash argon2id. Nunca sai da camada de repositorio.
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks         Task[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Uma linha por refresh token emitido. O token em si nunca e persistido,
/// apenas o hash, e o `id` da linha viaja como `jti` dentro do JWT.
/// Isso permite rotacionar e revogar sessões individualmente.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Recurso de exemplo. Use-o como molde ao criar novos módulos de domínio.
model Task {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  ownerId     String     @db.Uuid
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId, status])
  @@index([createdAt])
  @@map("tasks")
}
