# Copie para .env com `cp .env.example .env` e ajuste os valores.
# Todas as variaveis abaixo sao validadas com Zod no boot da aplicacao
# (src/config/env.validation.ts). Se faltar alguma, a API nao sobe e o erro
# lista exatamente o que esta faltando.

# ---------------------------------------------------------------- aplicacao
NODE_ENV=development
PORT=3000
# Prefixo global das rotas. As rotas ficam em /<API_PREFIX>/v1/...
API_PREFIX=api
# Origens liberadas no CORS, separadas por virgula. Use * para liberar tudo.
CORS_ORIGINS=http://localhost:3001

# ------------------------------------------------------------------- logs
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ------------------------------------------------------------------ banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

# -------------------------------------------------------------------- jwt
# Gere segredos fortes com: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# Use segredos DIFERENTES para access e refresh.
JWT_ACCESS_SECRET=troque-este-segredo-de-access-em-producao-0000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao-000000
JWT_REFRESH_TTL=7d

# ------------------------------------------------------------- rate limit
# Janela em milissegundos e numero de requisicoes permitidas por janela.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Limite estrito das rotas que recebem credenciais (login, cadastro, refresh).
THROTTLE_CREDENTIALS_TTL=60000
THROTTLE_CREDENTIALS_LIMIT=10

# ------------------------------------------------- recuperação de senha
# Endereço do frontend; o link enviado por e-mail aponta para
# <APP_URL>/redefinir-senha?token=...
APP_URL=http://localhost:3001
PASSWORD_RESET_TTL_MINUTES=30

# ------------------------------------------------------------------ e-mail
# O docker-compose sobe o Mailpit: SMTP em localhost:1025 e caixa de entrada
# em http://localhost:8025. Deixe SMTP_HOST vazio para só registrar os e-mails
# no log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=WenLock <nao-responda@wenlock.local>

# ---------------------------------------------------------------- swagger
# Desligue em producao se a documentacao nao deve ficar publica.
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
